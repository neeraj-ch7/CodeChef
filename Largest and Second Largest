import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        int t = scanner.nextInt();

        while (t-- > 0) {
            int n = scanner.nextInt();
            int[] a = new int[n];

            for (int i = 0; i < n; i++) {
                a[i] = scanner.nextInt();
            }
            // Your code goes here
            int  prev = 0 ;
            int curr= a[0];
            for(int i = 0;i<n;i++){
                if(a[i]>curr){
                    prev = curr;
                    curr= a[i];
                }
                if (a[i] > prev && a[i] != curr) {
                     prev = a[i];
                }
            }
            System.out.println(curr+prev);
            curr = a[0];
            prev = 0;
        }
    }
}
